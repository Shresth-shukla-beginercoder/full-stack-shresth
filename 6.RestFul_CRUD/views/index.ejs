<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Comments</title>
</head>
<body>
    <h1>Comments</h1>
    <ul>
        <% for (c of comment) {%>
            <li><%= c.comments %> - <b><%= c.username %></b> <a href="/comment/<%= c.id %>">Details</a></li>
            
        <% } %>
    </ul>
    <a href="/comment/new">New comments</a>
</body>
</html>