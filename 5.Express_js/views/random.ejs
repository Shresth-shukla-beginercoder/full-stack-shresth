<%- include('Partials/head') %>

<body>

<nav class="navbar">


<a href="/" class="logo">
    EJS<span>.Learn</span>
</a>

<ul class="nav-links">
    <li><a href="/">Tags</a></li>
    <li><a href="/random">Random</a></li>
</ul>


</nav>

<main class="random-page">


<div class="random-card">

    <h1>
        Random Number:
        <span class="random-number"><%= rand %></span>
    </h1>

    <% if (rand % 2 === 0) { %>

        <p class="even-message">
            This number is even, so this message is visible.
        </p>

    <% } else { %>

        <p class="odd-message">
            This number is odd, so this message is visible in an odd way ^^.
        </p>

    <% } %>

    <a href="/rand" class="btn">
        Generate Again
    </a>

</div>


</main>

<footer style="text-align:center;padding:2rem 0;color:#94a3b8;font-size:.9rem">
    EJS Learning Project • Built with Express + EJS<br>
    <a href="https://github.com/Shresth-shukla-beginercoder/full-stack-shresth" target="_blank" rel="noopener" style="color:#ff8a00;font-weight:700">📦 GitHub — full-stack-shresth</a>
</footer>

</body>
</html>
